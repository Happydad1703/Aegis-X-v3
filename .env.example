# =================================================================
# AEGIS-X v3 Phase 0 — 환경 변수 템플릿
# SE-65 디렉터리 구조 락 / Phase 0-1 Bootstrap
# 프로젝트 루트에 .env 로 복사 후 값 수정
# =================================================================

# ----- DB (docker-compose container_name: aegisx-db, 기본 호스트 포트 5433 → 5432) -----
# 포트 5433 충돌 시: docker compose -f docker-compose.yml -f docker-compose.5434.yml up -d
#                   아래 DB_PORT=5434 로 변경 후 DATABASE_URL/ASYNC_DATABASE_URL도 5434 사용
DB_HOST=localhost
DB_PORT=5433
DB_NAME=aegisx
DB_USER=postgres
DB_PASSWORD=2041
# 마이그레이션 시 사용할 컨테이너명 (기본값 aegisx-db)
# PG_CONTAINER=aegisx-db

# 동기 연결 (psycopg2) — 마이그레이션·스크립트용
# 5433 충돌 시: localhost:5434 로 변경하고 docker-compose.5434.yml 사용
DATABASE_URL=postgresql+psycopg2://postgres:2041@localhost:5433/aegisx

# 비동기 연결 (asyncpg) — API·워커용 (core/db.py)
# 5433 충돌 시: localhost:5434 로 변경
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:2041@localhost:5433/aegisx

# ----- API -----
API_HOST=0.0.0.0
API_PORT=8080

# ----- (선택) 기타 키 — 필요 시 주석 해제 -----
# KIS_APP_KEY=
# KIS_APP_SECRET=
# FRED_API_KEY=
